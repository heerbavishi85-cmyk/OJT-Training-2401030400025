<!DOCTYPE html>
<html>
<head>
    <title>Simple Animation</title>

    <style>
        .box {
            width: 100px;
            height: 100px;
            background-color: blue;
            margin: 100px auto;
            animation: zoom 2s infinite;
        }

        @keyframes zoom {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.5);
            }

            100% {
                transform: scale(1);
            }
        }
    </style>
</head>
<body>

    <div class="box"></div>

</body>
</html>
