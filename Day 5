<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HB Lifestyle</title>

  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body {
      font-family: 'Cinzel', serif;
      background-color: bisque;
    }

    /* HEADER */

    header {
      background-color: lightpink;
      padding: 30px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap:15px;
    }

    .logo h1 {
      font-size: 30px;
      color:#222;
    }

    .searchbar {
      display: flex;
      width: 300px;
      max-width:100%;
    }

    .searchbar input {
      flex:1;
      padding: 10px;
      border: none;
      outline: none;
      border-radius: 5px 0 0 5px;
    }

    .searchbar button {
      padding: 10px 15px;
      border: none;
      background: #333;
      color: white;
      cursor: pointer;
      border-radius: 0 5px 5px 0;
    }

    .icons {
      display: flex;
      gap: 20px;
    }

    .icons a {
      color: #333;
      font-size: 22px;
      transition: 0.3s;
    }

    .icons a:hover {
      color: black;
    }

    /* NAVBAR */

    .navbar {
      display: flex;
      justify-content: center;
      gap: 30px;
      padding: 12px;
      background: #fff5f5;
      flex-wrap: wrap;
      font-size: 17px;
    }

    .navbar div {
      cursor: pointer;
    }

    .navbar div:hover {
      text-decoration: underline;
    }

    /* CATEGORY BAR */

    .categorybar {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
      padding: 15px;
      background: linear-gradient(to right,#ffe0cc,#ffd6d6);
    }

    .categorybar a {
      text-decoration: none;
      color: #333;
      background:white;
      padding: 8px 15px;
      border-radius: 20px;
      transition: 0.3s;
      font-weight:bold;
    }

    .categorybar a:hover,
    .categorybar .active {
      background:#ff7f50;
      color:white;
    }

    /* BANNER */

    .slider img {
      width:100%;
      height:550px;
      object-fit:cover;
    }

    /* MAIN */

    main {
      text-align:center;
      padding:40px 20px;
    }

    main h2 {
      font-size:40px;
      margin-bottom:15px;
    }

    main p {
      font-size:20px;
      margin-bottom:10px;
    }

    /* PRODUCTS */

    .products {
      padding:40px 20px;
      display:flex;
      justify-content:center;
      flex-wrap:wrap;
      gap:25px;
    }

    .section-title {
      width:100%;
      text-align:center;
      margin-bottom:20px;
      font-size:35px;
      color:#333;
    }

    .product-card {
      width:230px;
      background:white;
      border-radius:10px;
      overflow:hidden;
      box-shadow:0 4px 10px rgba(0,0,0,0.2);
      transition:0.3s;
      text-align:center;
    }

    .product-card:hover {
      transform:translateY(-8px);
    }

    .product-card img {
      width:100%;
      height:260px;
      object-fit:cover;
    }

    .product-card h3 {
      margin:10px 0;
    }

    .product-card p {
      font-weight:bold;
      color:#444;
      margin-bottom:10px;
    }

    .product-card button {
      margin-bottom:15px;
      padding:10px 18px;
      border:none;
      background:#ff7f50;
      color:white;
      border-radius:5px;
      cursor:pointer;
      transition:0.3s;
    }

    .product-card button:hover {
      background:#e5673f;
    }

    /* CART */

    .cart {
      background:white;
      margin:30px;
      padding:25px;
      border-radius:10px;
      box-shadow:0 4px 10px rgba(0,0,0,0.2);
    }

    .cart h2 {
      text-align:center;
      margin-bottom:20px;
    }

    .cart ul {
      list-style:none;
    }

    .cart li {
      padding:10px 0;
      border-bottom:1px solid #ddd;
    }

    .total {
      margin-top:20px;
      text-align:right;
      font-size:22px;
      font-weight:bold;
    }

    /* MODAL */

    .modal {
      display:none;
      position:fixed;
      z-index:1000;
      left:0;
      top:0;
      width:100%;
      height:100%;
      background:rgba(0,0,0,0.5);
    }

    .modal-content {
      background:white;
      width:320px;
      margin:10% auto;
      padding:30px;
      border-radius:10px;
      position:relative;
      text-align:center;
    }

    .close {
      position:absolute;
      top:10px;
      right:15px;
      font-size:25px;
      cursor:pointer;
    }

    .modal-content input {
      width:100%;
      padding:10px;
      margin:10px 0;
      border:1px solid #ccc;
      border-radius:5px;
    }

    .modal-content button {
      width:100%;
      padding:10px;
      border:none;
      background:#ff7f50;
      color:white;
      border-radius:5px;
      cursor:pointer;
    }

    .modal-content button:hover {
      background:#e5673f;
    }

    .modal-content a {
      display:block;
      margin-top:12px;
      text-decoration:none;
      color:#333;
    }

    /* RESPONSIVE */

    @media(max-width:768px){

      .slider img{
        height:300px;
      }

      .product-card{
        width:100%;
        max-width:300px;
      }

      header{
        justify-content:center;
      }

      .searchbar{
        width:100%;
      }

    }

  </style>
</head>

<body>

  <!-- HEADER -->

  <header>

    <div class="logo">
      <h1>HB Lifestyle</h1>
    </div>

    <div class="searchbar">
      <input type="text" placeholder="Search Products">
      <button>Search</button>
    </div>

    <div class="icons">

      <a href="#">
        <i class="fas fa-heart"></i>
      </a>

      <a href="#">
        <i class="fas fa-shopping-cart"></i>
      </a>

      <a href="#" id="signinBtn">
        <i class="fas fa-user"></i>
      </a>

    </div>

  </header>

  <!-- NAVBAR -->

  <nav class="navbar">

    <div>🚚 Free Shipping</div>
    <div>🛍️ Click & Collect</div>
    <div>🔒 Return to Store</div>
    <div>📍 Delivering To</div>
    <div>❓ Help</div>

  </nav>

  <!-- CATEGORY BAR -->

  <nav class="categorybar">

    <a href="#" class="active">Women</a>
    <a href="#">Men</a>
    <a href="#">Kids</a>
    <a href="#">Footwear</a>
    <a href="#">Bags</a>
    <a href="#">Beauty</a>
    <a href="#">Watches</a>

  </nav>

  <!-- BANNER -->

  <div class="slider">

    <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=1400&auto=format&fit=crop">

  </div>

  <!-- MAIN -->

  <main>

    <h2>NEW ARRIVAL</h2>
    <p>Fashion that fits your lifestyle</p>

  </main>

  <!-- WOMEN -->

  <section class="products">

    <h2 class="section-title">Women Collection</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=800&auto=format&fit=crop">
      <h3>Floral Dress</h3>
      <p>₹1,499</p>
      <button onclick="addToCart('Floral Dress',1499)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=800&auto=format&fit=crop">
      <h3>Women Kurti</h3>
      <p>₹999</p>
      <button onclick="addToCart('Women Kurti',999)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=800&auto=format&fit=crop">
      <h3>Casual Top</h3>
      <p>₹799</p>
      <button onclick="addToCart('Casual Top',799)">Add to Cart</button>
    </div>

  <!-- MEN -->


    <h2 class="section-title">Men Collection</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=800&auto=format&fit=crop">
      <h3>Men Jacket</h3>
      <p>₹2,499</p>
      <button onclick="addToCart('Men Jacket',2499)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=800&auto=format&fit=crop">
      <h3>Casual T-Shirt</h3>
      <p>₹699</p>
      <button onclick="addToCart('Casual T-Shirt',699)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?q=80&w=800&auto=format&fit=crop">
      <h3>Formal Shirt</h3>
      <p>₹1,299</p>
      <button onclick="addToCart('Formal Shirt',1299)">Add to Cart</button>
    </div>

  </section>

  <!-- KIDS -->

  <section class="products">

    <h2 class="section-title">Kids Collection</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1519345182560-3f2917c472ef?q=80&w=800&auto=format&fit=crop">
      <h3>Kids Hoodie</h3>
      <p>₹899</p>
      <button onclick="addToCart('Kids Hoodie',899)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?q=80&w=800&auto=format&fit=crop">
      <h3>Kids Party Wear</h3>
      <p>₹1,199</p>
      <button onclick="addToCart('Kids Party Wear',1199)">Add to Cart</button>
    </div>

  </section>

  <!-- FOOTWEAR -->

  <section class="products">

    <h2 class="section-title">Footwear</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=800&auto=format&fit=crop">
      <h3>Stylish Shoes</h3>
      <p>₹2,299</p>
      <button onclick="addToCart('Stylish Shoes',2299)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?q=80&w=800&auto=format&fit=crop">
      <h3>Running Sneakers</h3>
      <p>₹1,999</p>
      <button onclick="addToCart('Running Sneakers',1999)">Add to Cart</button>
    </div>

  </section>

  <!-- BAGS -->

  <section class="products">

    <h2 class="section-title">Bags Collection</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=800&auto=format&fit=crop">
      <h3>Luxury Bag</h3>
      <p>₹3,199</p>
      <button onclick="addToCart('Luxury Bag',3199)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=800&auto=format&fit=crop">
      <h3>Travel Backpack</h3>
      <p>₹1,599</p>
      <button onclick="addToCart('Travel Backpack',1599)">Add to Cart</button>
    </div>

  </section>

  <!-- WATCHES -->

  <section class="products">

    <h2 class="section-title">Watches</h2>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=800&auto=format&fit=crop">
      <h3>Luxury Watch</h3>
      <p>₹4,999</p>
      <button onclick="addToCart('Luxury Watch',4999)">Add to Cart</button>
    </div>

    <div class="product-card">
      <img src="https://images.unsplash.com/photo-1434056886845-dac89ffe9b56?q=80&w=800&auto=format&fit=crop">
      <h3>Smart Watch</h3>
      <p>₹2,799</p>
      <button onclick="addToCart('Smart Watch',2799)">Add to Cart</button>
    </div>

  </section>

  <!-- CART -->

  <section class="cart">

    <h2>Shopping Cart</h2>
    <ul id="cartItems"></ul>
    <div class="total">
      Total: ₹<span id="total">0</span>
    </div>

  </section>

  <!-- LOGIN MODAL -->

  <div class="modal" id="loginModal">

    <div class="modal-content">

      <span class="close">&times;</span>
      <h2>Sign In</h2>

      <form>

        <input type="text" placeholder="Username" required>
        <input type="password" placeholder="Password" required>
        <button type="submit">Login</button>

      </form>

      <a href="#">Forgot Password?</a>
      <a href="#" id="createAccountLink">Create Account</a>

    </div>

  </div>

  <!-- CREATE ACCOUNT MODAL -->

  <div class="modal" id="createModal">

    <div class="modal-content">

      <span class="close">&times;</span>
      <h2>Create Account</h2>

      <form>

        <input type="text" placeholder="Username" required>
        <input type="email" placeholder="Email" required>
        <input type="password" placeholder="Password" required>
        <button type="submit">Register</button>

      </form>

    </div>

  </div>

  <!-- JAVASCRIPT -->

  <script>

    let total = 0;

    function addToCart(product, price){

      const cartItems = document.getElementById("cartItems");
      const li = document.createElement("li");
      li.textContent = `${product} - ₹${price}`;
      cartItems.appendChild(li);
      total += price;
      document.getElementById("total").textContent = total;

    }

    /* MODAL */

    const loginModal = document.getElementById("loginModal");
    const createModal = document.getElementById("createModal");
    const signinBtn = document.getElementById("signinBtn");
    const closeButtons = document.querySelectorAll(".close");
    const createLink = document.getElementById("createAccountLink");

    signinBtn.onclick = function () {
      loginModal.style.display = "block";
    }

    closeButtons.forEach(btn => {

      btn.onclick = function () {

        loginModal.style.display = "none";
        createModal.style.display = "none";

      }

    });

    createLink.onclick = function(e){

      e.preventDefault();

      loginModal.style.display = "none";

      createModal.style.display = "block";

    }

    window.onclick = function(event){

      if(event.target == loginModal){
        loginModal.style.display = "none";
      }

      if(event.target == createModal){
        createModal.style.display = "none";
      }

    }
  </script>

</body>
</html>
