<script>

function scrollToSection(sectionId){
document.getElementById(sectionId).scrollIntoView({
behavior:'smooth'
});
}

/* CART + WISHLIST */

let total = 0;
let cart = [];
let wishlist = [];

/* ADD TO CART */

function addToCart(product,price){

const existingItem =
cart.find(item => item.product === product);

if(existingItem){

existingItem.quantity += 1;

}else{

cart.push({
product,
price,
quantity:1
});

}

updateCartUI();

alert(`${product} added to cart!`);

}

/* UPDATE CART UI */

function updateCartUI(){

const cartItems =
document.getElementById("cartItems");

cartItems.innerHTML = "";

total = 0;

cart.forEach((item,index)=>{

const itemTotal =
item.price * item.quantity;

total += itemTotal;

let li =
document.createElement("li");

li.className =
"list-group-item d-flex justify-content-between align-items-center shadow-sm mb-2 rounded border-0";

li.innerHTML = `

<div>
<h6 class="mb-1 fw-bold">${item.product}</h6>

<div class="d-flex align-items-center gap-2">

<button class="btn btn-sm btn-dark rounded-circle"
onclick="decreaseQty(${index})">-</button>

<span class="fw-semibold">
${item.quantity}
</span>

<button class="btn btn-sm btn-dark rounded-circle"
onclick="increaseQty(${index})">+</button>

</div>
</div>

<div class="text-end">

<div class="fw-bold text-success mb-2">
₹${itemTotal}
</div>

<button class="btn btn-sm btn-danger rounded-pill"
onclick="removeItem(${index})">

Remove

</button>

</div>

`;

cartItems.appendChild(li);

});

document.getElementById("total").innerText = total;
document.getElementById("paymentTotal").innerText = total;
document.getElementById("finalTotal").innerText = total;

}

/* QUANTITY INCREASE */

function increaseQty(index){

cart[index].quantity += 1;
updateCartUI();

}

/* QUANTITY DECREASE */

function decreaseQty(index){

if(cart[index].quantity > 1){

cart[index].quantity -= 1;

}else{

cart.splice(index,1);

}

updateCartUI();

}

/* REMOVE ITEM */

function removeItem(index){

cart.splice(index,1);
updateCartUI();

}

/* WISHLIST */

function addToWishlist(product,price){

const alreadyExists =
wishlist.find(item => item.product === product);

if(alreadyExists){

alert("Already in wishlist ❤️");
return;

}

wishlist.push({
product,
price
});

updateWishlistUI();

alert(`${product} added to wishlist ❤️`);

}

function updateWishlistUI(){

const wishlistItems =
document.getElementById("wishlistItems");

wishlistItems.innerHTML = "";

wishlist.forEach((item,index)=>{

let li =
document.createElement("li");

li.className =
"list-group-item d-flex justify-content-between align-items-center shadow-sm mb-2 rounded border-0";

li.innerHTML = `

<div>
<h6 class="mb-1 fw-bold">${item.product}</h6>

<span class="text-success fw-semibold">
₹${item.price}
</span>
</div>

<div class="d-flex gap-2">

<button class="btn btn-warning rounded-pill btn-sm fw-bold"
onclick="moveToCart(${index})">

Add to Cart

</button>

<button class="btn btn-danger rounded-pill btn-sm fw-bold"
onclick="removeWishlist(${index})">

Remove

</button>

</div>

`;

wishlistItems.appendChild(li);

});

}

/* MOVE TO CART */

function moveToCart(index){

const item = wishlist[index];

addToCart(item.product,item.price);

wishlist.splice(index,1);

updateWishlistUI();

}

/* REMOVE WISHLIST ITEM */

function removeWishlist(index){

wishlist.splice(index,1);

updateWishlistUI();

}

/* PLACE ORDER */

function placeOrder(){

if(total === 0){

alert("Please add products to cart before payment!");
return;

}

const name =
document.querySelector('input[placeholder="Enter Full Name"]').value;

const mobile =
document.querySelector('input[placeholder="Enter Mobile Number"]').value;

const address =
document.querySelector('textarea').value;

const pincode =
document.querySelector('input[placeholder="Enter Pincode"]').value;

if(name === "" || mobile === "" || address === "" || pincode === ""){

alert("Please fill all delivery details!");
return;

}

alert("Order Placed Successfully! Thank you for shopping with HB Lifestyle ❤️");

cart = [];

updateCartUI();

}

/* LOGIN SIGNUP */

const toggleAuth =
document.getElementById("toggleAuth");

const loginForm =
document.getElementById("loginForm");

const signupForm =
document.getElementById("signupForm");

const modalTitle =
document.getElementById("modalTitle");

toggleAuth.addEventListener("click", function(){

if(loginForm.style.display !== "none"){

loginForm.style.display = "none";
signupForm.style.display = "block";

modalTitle.innerText = "Sign Up";

toggleAuth.innerText =
"Already have an account? Sign In";

}else{

loginForm.style.display = "block";
signupForm.style.display = "none";

modalTitle.innerText = "Sign In";

toggleAuth.innerText =
"Don't have an account? Sign Up";

}
/* LOGIN SIGNUP */

const toggleAuth =
document.getElementById("toggleAuth");

const loginForm =
document.getElementById("loginForm");

const signupForm =
document.getElementById("signupForm");

const modalTitle =
document.getElementById("modalTitle");

/* TOGGLE LOGIN SIGNUP */

toggleAuth.addEventListener("click", function(){

if(loginForm.style.display !== "none"){

loginForm.style.display = "none";
signupForm.style.display = "block";

modalTitle.innerText = "Sign Up";

toggleAuth.innerText =
"Already have an account? Sign In";

}else{

loginForm.style.display = "block";
signupForm.style.display = "none";

modalTitle.innerText = "Sign In";

toggleAuth.innerText =
"Don't have an account? Sign Up";

}

});

/* EMAIL VALIDATION */

function validEmail(email){

return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

}

/* LOGIN VALIDATION */

loginForm.addEventListener("submit", function(e){

e.preventDefault();

const email =
loginForm.querySelector('input[type="email"]').value.trim();

const password =
loginForm.querySelector('input[type="password"]').value.trim();

if(email === "" || password === ""){

alert("Please fill all login details!");
return;

}

if(!validEmail(email)){

alert("Please enter a valid email address!");
return;

}

if(password.length < 6){

alert("Password must be at least 6 characters!");
return;

}

alert("Login Successful ❤️");

const modal =
bootstrap.Modal.getInstance(
document.getElementById("loginModal")
);

modal.hide();

});

/* SIGNUP VALIDATION */

signupForm.addEventListener("submit", function(e){

e.preventDefault();

const name =
signupForm.querySelector('input[type="text"]').value.trim();

const email =
signupForm.querySelector('input[type="email"]').value.trim();

const password =
signupForm.querySelector('input[type="password"]').value.trim();

if(name === "" || email === "" || password === ""){

alert("Please fill all signup details!");
return;

}

if(name.length < 3){

alert("Name must be at least 3 characters!");
return;

}

if(!validEmail(email)){

alert("Please enter a valid email address!");
return;

}

if(password.length < 6){

alert("Password must be at least 6 characters!");
return;

}

alert("Account Created Successfully ❤️");

signupForm.reset();

loginForm.style.display = "block";
signupForm.style.display = "none";

modalTitle.innerText = "Sign In";

toggleAuth.innerText =
"Don't have an account? Sign Up";

});

});

</script>

