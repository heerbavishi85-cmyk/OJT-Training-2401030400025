  { name:"Kabir Sharma", loc:"Delhi", avatar:"K", food:"Chole Bhature", rating:4, text:"Sitaram's chole bhature in Old Delhi is legendary for a reason. The bhatura is perfectly puffed and the chole has this smoky depth that haunts you for days." },
  { name:"Anjali Nair", loc:"Bengaluru", avatar:"A", food:"Medu Vada", rating:5, text:"Murugan Idli's medu vada is everything. Crispy outside, soft inside, and their coconut chutney is genuinely the best I've had outside Kerala." },
  { name:"Dev Patel", loc:"Jaipur", avatar:"D", food:"Raj Kachori", rating:5, text:"Rawat's Raj Kachori is an experience, not just a snack. It's massive, loaded with flavour and utterly impossible to finish alone — yet you'll always want more." },
];

// ── RENDER ──
function renderStars(r) {
  const full = Math.floor(r); const half = r % 1 >= 0.5 ? 1 : 0;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(5 - full - half);
}

function renderFoods(list) {
  const grid = $('#foodGrid');
  grid.empty();
  list.forEach((f, i) => {
    const badgeHtml = f.badge ? `<div class="food-badge ${f.badge}">${f.badge === 'trending' ? '🔥 Trending' : f.badge === 'new' ? '✨ New' : '⭐ Popular'}</div>` : '';
    const card = `
      <div class="food-card" style="animation-delay:${i*0.06}s" onclick="openModal(${f.id})">
        <div class="food-img-wrap">
          <img src="${f.img}" alt="${f.name}" loading="lazy">
          ${badgeHtml}
          <button class="food-bookmark" onclick="event.stopPropagation();toggleSave(this)"></button>
          ${f.spice ? `<div class="spice-tag">${f.spice}</div>` : ''}
        </div>
        <div class="food-body">
          <div class="food-city">${f.city}</div>
          <div class="food-name">${f.name}</div>
          <div class="food-desc">${f.desc}</div>
          <div class="food-footer">
            <div class="food-rating">
              <span class="stars">${renderStars(f.rating)}</span>
              ${f.rating} <span class="reviews-count">(${f.reviews.toLocaleString()})</span>
            </div>
            <div class="food-price">${f.price}</div>
          </div>
        </div>
      </div>`;
    grid.append(card);
  });
}

function renderCities() {
  const grid = $('#citiesGrid');
  cities.forEach(c => {
    grid.append(`
      <div class="city-card">
        <img src="${c.img}" alt="${c.name}" loading="lazy">
        <div class="city-overlay">
          <div class="city-name">${c.name}</div>
          <div class="city-count">${c.count}</div>
        </div>
      </div>`);
  });
}

function renderReviews() {
  const grid = $('#reviewsGrid');
  reviews.forEach(r => {
    grid.append(`
      <div class="review-card">
        <div class="reviewer">
          <div class="reviewer-avatar">${r.avatar}</div>
          <div>
            <div class="reviewer-name">${r.name}</div>
            <div class="reviewer-loc">📍 ${r.loc}</div>
          </div>
        </div>
        <div class="review-stars">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</div>
        <div class="review-text">${r.text}</div>
        <div class="review-food"><div class="review-food-name">🍽️ ${r.food}</div></div>
      </div>`);
  });
}

// ── MODAL ──
function openModal(id) {
  const f = foods.find(x => x.id === id);
  if (!f) return;
  $('#modalImg').attr('src', f.img).attr('alt', f.name);
  $('#modalTitle').text(f.name);
  $('#modalMeta').html(`
    <span>📍 ${f.city}</span>
    <span>⭐ ${f.rating}</span>
    <span>💰 ${f.price}</span>
    <span>${f.spice || '🟢 Mild'}</span>
  `);
  $('#modalDesc').text(f.desc);
  $('#modalDetails').html(`
    <div class="modal-detail"><div class="modal-detail-label">Famous Stall</div><div class="modal-detail-val">${f.famous}</div></div>
    <div class="modal-detail"><div class="modal-detail-label">Open Hours</div><div class="modal-detail-val">${f.hours}</div></div>
    <div class="modal-detail"><div class="modal-detail-label">Reviews</div><div class="modal-detail-val">${f.reviews.toLocaleString()}</div></div>
    <div class="modal-detail"><div class="modal-detail-label">Category</div><div class="modal-detail-val" style="text-transform:capitalize">${f.cat}</div></div>
  `);
  $('#modal').addClass('active');
  $('body').css('overflow', 'hidden');
}

function closeModal() {
  $('#modal').removeClass('active');
  $('body').css('overflow', '');
}

$('#modal').on('click', function(e) { if ($(e.target).is('#modal')) closeModal(); });

// ── FILTER / SORT ──
let currentCat = 'all';
let currentSort = 'top';

function getFiltered() {
  let list = currentCat === 'all' ? [...foods] : foods.filter(f => f.cat === currentCat);
  if (currentSort === 'top') list.sort((a,b) => b.rating - a.rating);
  if (currentSort === 'new') list.sort((a,b) => b.id - a.id);
  if (currentSort === 'price') list.sort((a,b) => parseInt(a.price.replace('₹','')) - parseInt(b.price.replace('₹','')));
  return list;
}

$('#catStrip').on('click', '.cat-pill', function() {
  $('.cat-pill').removeClass('active');
  $(this).addClass('active');
  currentCat = $(this).data('cat');
  renderFoods(getFiltered());
});

function sortFood(type) {
  currentSort = type;
  $('.filter-btn').removeClass('active');
  $(`.filter-btn[onclick="sortFood('${type}')"]`).addClass('active');
  renderFoods(getFiltered());
}

function filterTag(tag) {
  const tagMap = { 'Spicy': 'chaat', 'Veg': 'chaat', 'Dessert': 'dessert', 'Snacks': 'snacks', 'Breakfast': 'breakfast', 'Trending': 'all' };
  currentCat = tagMap[tag] || 'all';
  currentSort = tag === 'Trending' ? 'top' : currentSort;
  if (tag === 'Under ₹50') {
    currentSort = 'price';
    renderFoods(foods.filter(f => parseInt(f.price.replace('₹','')) <= 50));
    return;
  }
  $('.cat-pill').removeClass('active');
  $(`.cat-pill[data-cat="${currentCat}"]`).addClass('active');
  renderFoods(getFiltered());
  $('html,body').animate({scrollTop: $('#discover').offset().top - 80}, 400);
  showToast(`Showing: ${tag} 🍽️`);
}

function searchFood() {
  const q = $('#searchInput').val().toLowerCase().trim();
  if (!q) { renderFoods(getFiltered()); return; }
  const res = foods.filter(f => f.name.toLowerCase().includes(q) || f.city.toLowerCase().includes(q) || f.desc.toLowerCase().includes(q));
  if (res.length === 0) { showToast('No results found. Try another search!'); return; }
  renderFoods(res);
  $('html,body').animate({scrollTop: $('#discover').offset().top - 80}, 400);
  showToast(`Found ${res.length} result${res.length > 1 ? 's' : ''} 🔍`);
}

$('#searchInput').on('keydown', function(e) { if (e.key === 'Enter') searchFood(); });

// ── SAVE / BOOKMARK ──
function toggleSave(btn) {
  $(btn).toggleClass('saved');
  showToast($(btn).hasClass('saved') ? '🔖 Saved to your list!' : '❌ Removed from list');
}

// ── NEWSLETTER ──
function subscribeNL() {
  const email = $('#nlEmail').val().trim();
  if (!email || !email.includes('@')) { showToast('Please enter a valid email 📧'); return; }
  showToast('🎉 You\'re subscribed! Welcome to StreetBites!');
  $('#nlEmail').val('');
}

// ── TOAST ──
function showToast(msg) {
  const t = $('#toast');
  t.text(msg).addClass('show');
  setTimeout(() => t.removeClass('show'), 2800);
}

// ── SCROLL EFFECTS ──
$(window).on('scroll', function() {
  const st = $(this).scrollTop();
  if (st > 60) $('#navbar').addClass('scrolled'); else $('#navbar').removeClass('scrolled');
  if (st > 300) $('#scrollTop').addClass('visible'); else $('#scrollTop').removeClass('visible');
});

// ── INIT ──
$(document).ready(function() {
  renderFoods(getFiltered());
  renderCities();
  renderReviews();
});

</script>
